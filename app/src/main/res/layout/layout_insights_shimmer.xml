<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.1"
    app:shimmer_highlight_alpha="0.3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header shimmer -->
        <View
            android:layout_width="150dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_surface_dark_rounded"
            android:layout_marginBottom="8dp"/>
        <View
            android:layout_width="200dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_surface_dark_rounded"
            android:layout_marginBottom="24dp"/>

        <!-- Stats row shimmer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:background="@drawable/bg_surface_dark_rounded" android:layout_marginEnd="8dp"/>
            <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:background="@drawable/bg_surface_dark_rounded" android:layout_marginEnd="8dp"/>
            <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:background="@drawable/bg_surface_dark_rounded"/>
        </LinearLayout>

        <!-- Insights shimmer -->
        <View android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_surface_dark_rounded" android:layout_marginBottom="12dp"/>
        <View android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_surface_dark_rounded" android:layout_marginBottom="12dp"/>
        <View android:layout_width="match_parent" android:layout_height="100dp" android:background="@drawable/bg_surface_dark_rounded" android:layout_marginBottom="12dp"/>

    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
