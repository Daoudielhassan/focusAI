<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ui.main.HomeActivity">

    <!-- === BACKGROUND GLOW LAYERS === -->
    <View
        android:id="@+id/glowTop"
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:alpha="0.18"
        android:background="@drawable/bg_ambient_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glowRight"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.08"
        android:background="@drawable/bg_ambient_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- === SCROLL CONTENT === -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- === TOP BAR === -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_greeting_small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bonjour 👋"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_greeting_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Prêt à vous concentrer ?"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Streak Badge -->
                <LinearLayout
                    android:id="@+id/streakBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_streak_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_streak_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="@color/primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="jours"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- === HERO ORB SECTION === -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bento_card_glow"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:id="@+id/tv_status_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_primary"
                        android:letterSpacing="0.15"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp"
                        android:text="⚡  LUMINA ACTIVE"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/orbContainer"
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:layout_marginTop="24dp">

                        <View
                            android:id="@+id/view_orb_ring_outer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_orb_pulse" />

                        <View
                            android:id="@+id/view_orb_ring_inner"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            android:alpha="0.3"
                            android:background="@drawable/bg_orb_ring" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_orb"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="@color/surface_dark"
                            app:cardCornerRadius="80dp"
                            app:cardElevation="28dp">

                            <ImageView
                                android:id="@+id/img_orb_background"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_image_placeholder"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop" />

                            <View
                                android:id="@+id/orbOverlay"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_image_overlay" />

                            <ImageView
                                android:id="@+id/img_orb_icon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:alpha="0.85"
                                android:contentDescription="@null"
                                android:src="@android:drawable/ic_menu_recent_history"
                                app:tint="@color/primary" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_quote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:text="&quot;La concentration est la racine de toute réussite.&quot;"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- === BENTO GRID ROW 1 === -->
            <LinearLayout
                android:id="@+id/bentoRowOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Duration Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="⏱  DURÉE"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_duration_15"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_duration_chip_inactive"
                                android:gravity="center"
                                android:text="15 min"
                                android:textColor="@color/text_secondary_dark"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_duration_30"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_duration_chip_active"
                                android:gravity="center"
                                android:text="30 min"
                                android:textColor="@color/background_dark"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_duration_60"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_duration_chip_inactive"
                                android:gravity="center"
                                android:text="60 min"
                                android:textColor="@color/text_secondary_dark"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Today Stats Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardToday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="📊  AUJOURD'HUI"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_today_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="0h 00"
                            android:textColor="@color/primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="focus total"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="#1A13EC5B" />

                        <TextView
                            android:id="@+id/tv_today_sessions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="sessions"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- === BENTO GRID ROW 2 === -->
            <LinearLayout
                android:id="@+id/bentoRowTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Ambiance Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAmbiance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="🎵  AMBIANCE"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ambiance_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Nightwave Plaza"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Radio Lofi · En direct"
                            android:textColor="@color/primary"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/equalizerBars"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginTop="14dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/eq_bar_1"
                                android:layout_width="4dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="4dp"
                                android:alpha="0.9"
                                android:background="@color/primary" />

                            <View
                                android:id="@+id/eq_bar_2"
                                android:layout_width="4dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="4dp"
                                android:alpha="0.7"
                                android:background="@color/primary" />

                            <View
                                android:id="@+id/eq_bar_3"
                                android:layout_width="4dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="4dp"
                                android:alpha="0.9"
                                android:background="@color/primary" />

                            <View
                                android:id="@+id/eq_bar_4"
                                android:layout_width="4dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="4dp"
                                android:alpha="0.6"
                                android:background="@color/primary" />

                            <View
                                android:id="@+id/eq_bar_5"
                                android:layout_width="4dp"
                                android:layout_height="10dp"
                                android:alpha="0.8"
                                android:background="@color/primary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Lumina Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLumina"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/glass_surface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="✨  LUMINA"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_lumina_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="0%"
                            android:textColor="@color/primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="score focus"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_lumina_reco"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="30 min · Ambient"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ai_tip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:text="Votre pic de concentration est généralement le matin. Commencez maintenant !"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_ai_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_pill_primary"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Insight IA"
                            android:textColor="@color/primary"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- === CTA BUTTON === -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_commencer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary_button"
                android:letterSpacing="0.02"
                android:text="⚡  Démarrer la session"
                android:textAllCaps="false"
                android:textColor="@color/background_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="22dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- === BOTTOM NAV === -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>