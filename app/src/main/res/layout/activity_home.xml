<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".HomeActivity">

    <!-- Ambient Glow -->
    <View
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:background="@drawable/bg_ambient_glow"
        app:layout_constraintTop_toTopOf="parent"
        android:alpha="0.3" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <Space android:layout_width="match_parent" android:layout_height="64dp" />

            <!-- Status Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_primary"
                android:text="LUMINA READY"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="24dp" />

            <!-- Orb Graphic (Unified) -->
            <FrameLayout
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_marginTop="40dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_orb_ring"
                    android:alpha="0.5" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="32dp"
                    app:cardCornerRadius="140dp"
                    app:cardElevation="24dp"
                    app:cardBackgroundColor="@color/surface_dark">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_image_placeholder"
                        android:contentDescription="@null" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_image_overlay" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Duration Selection (Harmonized) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_dark_rounded"
                android:orientation="horizontal"
                android:padding="6dp"
                android:layout_marginTop="48dp">

                <TextView
                    android:id="@+id/tv_duration_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15m"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="14sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp" />

                <TextView
                    android:id="@+id/tv_duration_30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_duration_chip_active"
                    android:text="30m"
                    android:textColor="@color/background_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp" />

                <TextView
                    android:id="@+id/tv_duration_60"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60m"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="14sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_commencer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/home_btn_commencer"
                android:textColor="@color/background_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
