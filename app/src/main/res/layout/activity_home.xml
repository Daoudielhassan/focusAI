<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ui.main.HomeActivity">

    <!-- === BACKGROUND GLOW LAYERS === -->
    <View
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:alpha="0.18"
        android:background="@drawable/bg_ambient_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:alpha="0.08"
        android:background="@drawable/bg_ambient_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- === SCROLL CONTENT === -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- === TOP BAR === -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bonjour 👋"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_greeting_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prêt à vous concentrer ?"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Streak Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_streak_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:id="@+id/tv_streak_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="@color/primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="jours"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- === HERO ORB SECTION === -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bento_card_glow"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:layout_marginTop="20dp">

                <!-- Label animé -->
                <TextView
                    android:id="@+id/tv_status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_primary"
                    android:letterSpacing="0.15"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="⚡  LUMINA ACTIVE"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- ORB avec progress circulaire -->
                <FrameLayout
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="24dp">

                    <!-- Pulsing outer ring -->
                    <View
                        android:id="@+id/view_orb_ring_outer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_orb_pulse"
                        android:layout_gravity="center" />

                    <!-- Inner ring -->
                    <View
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:background="@drawable/bg_orb_ring"
                        android:layout_gravity="center"
                        android:alpha="0.3" />

                    <!-- Main Orb -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_orb"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_gravity="center"
                        app:cardCornerRadius="80dp"
                        app:cardElevation="32dp"
                        app:cardBackgroundColor="@color/surface_dark">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_image_placeholder"
                            android:contentDescription="@null" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_image_overlay" />

                        <!-- Center icon -->
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_recent_history"
                            android:contentDescription="@null"
                            app:tint="@color/primary"
                            android:alpha="0.8" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <!-- Quote sous l'orbe -->
                <TextView
                    android:id="@+id/tv_quote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="&quot;La concentration est la racine de toute réussite.&quot;"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <!-- === BENTO GRID ROW 1 : Durée + Aujourd'hui === -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <!-- Carte durée -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bento_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱  DURÉE"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                    <!-- Duration chips verticaux -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:id="@+id/tv_duration_15"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="15 min"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="13sp"
                            android:background="@drawable/bg_duration_chip_inactive"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tv_duration_30"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="30 min"
                            android:textColor="@color/background_dark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_duration_chip_active"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tv_duration_60"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="60 min"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="13sp"
                            android:background="@drawable/bg_duration_chip_inactive" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Carte Stats du jour -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bento_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊  AUJOURD'HUI"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                    <!-- Stat 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/tv_today_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0h 00"
                            android:textColor="@color/primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="focus total"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1A13ec5b"
                        android:layout_marginVertical="14dp" />

                    <!-- Stat 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_today_sessions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="sessions"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- === BENTO ROW 2 : Mode focus + Ambiance === -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <!-- Carte Ambiance -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bento_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵  AMBIANCE"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_ambiance_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nightwave Plaza"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Radio Lofi · En direct"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                    <!-- Equalizer dots -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="14dp">

                        <View android:id="@+id/eq_bar_1"
                            android:layout_width="4dp" android:layout_height="8dp"
                            android:background="@color/primary" android:layout_marginEnd="4dp" android:alpha="0.9"/>
                        <View android:id="@+id/eq_bar_2"
                            android:layout_width="4dp" android:layout_height="18dp"
                            android:background="@color/primary" android:layout_marginEnd="4dp" android:alpha="0.7"/>
                        <View android:id="@+id/eq_bar_3"
                            android:layout_width="4dp" android:layout_height="12dp"
                            android:background="@color/primary" android:layout_marginEnd="4dp" android:alpha="0.9"/>
                        <View android:id="@+id/eq_bar_4"
                            android:layout_width="4dp" android:layout_height="22dp"
                            android:background="@color/primary" android:layout_marginEnd="4dp" android:alpha="0.6"/>
                        <View android:id="@+id/eq_bar_5"
                            android:layout_width="4dp" android:layout_height="10dp"
                            android:background="@color/primary" android:alpha="0.8"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Carte Conseil IA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bento_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨  LUMINA"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_ai_tip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Votre pic de concentration est généralement le matin. Commencez maintenant !"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_primary"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Insight IA"
                        android:textColor="@color/primary"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- === CTA BUTTON === -->
            <Button
                android:id="@+id/btn_commencer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary_button"
                android:text="⚡  Démarrer la session"
                android:textColor="@color/background_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:letterSpacing="0.02" />

        </LinearLayout>
    </ScrollView>

    <!-- === BOTTOM NAV === -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
