<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_bottom_nav_container"
        android:elevation="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/nav_home_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/nav_home"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="Accueil"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/text_secondary_dark" />

            <TextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Accueil"
                android:textColor="@color/text_secondary_dark"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Lumina -->
        <LinearLayout
            android:id="@+id/nav_lumina_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/nav_insights_ia"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="Lumina IA"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_lumina"
                app:tint="@color/text_secondary_dark" />

            <TextView
                android:id="@+id/nav_lumina_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lumina"
                android:textColor="@color/text_secondary_dark"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Stats -->
        <LinearLayout
            android:id="@+id/nav_stats_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/nav_stats"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="Statistiques"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_stats"
                app:tint="@color/text_secondary_dark" />

            <TextView
                android:id="@+id/nav_stats_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Stats"
                android:textColor="@color/text_secondary_dark"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/nav_settings_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/nav_settings"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="Réglages"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/text_secondary_dark" />

            <TextView
                android:id="@+id/nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Réglages"
                android:textColor="@color/text_secondary_dark"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>