<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ui.main.StatsActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="@null"
            app:tint="@color/text_secondary_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="INSIGHTS"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_surface_dark_rounded">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:contentDescription="@null"
                app:tint="@color/text_secondary_dark"
                android:padding="12dp" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/ll_header"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Total Focus Time Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL FOCUS TIME"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">
                    <TextView
                        android:id="@+id/tv_total_hours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/primary"
                        android:textSize="48sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="h "
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tv_total_minutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/primary"
                        android:textSize="48sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="m"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↗ +2.5h from last week"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Activity Chart Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="24dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACTIVITY"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp"
                        android:letterSpacing="0.1" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This Week"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp"
                        android:background="@drawable/bg_surface_dark_rounded"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <!-- Custom Bar Chart using Weights -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="bottom"
                    android:weightSum="7">

                    <!-- Day 1 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/bar_1" android:layout_width="16dp" android:layout_height="48dp" android:background="@drawable/bg_chart_bar_inactive" />
                        <TextView android:id="@+id/tv_day_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:textColor="@color/text_secondary_dark" android:textSize="12sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <!-- Day 2 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/bar_2" android:layout_width="16dp" android:layout_height="72dp" android:background="@drawable/bg_chart_bar_inactive" />
                        <TextView android:id="@+id/tv_day_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" android:textColor="@color/text_secondary_dark" android:textSize="12sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <!-- Day 3 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/bar_3" android:layout_width="16dp" android:layout_height="36dp" android:background="@drawable/bg_chart_bar_inactive" />
                        <TextView android:id="@+id/tv_day_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="W" android:textColor="@color/text_secondary_dark" android:textSize="12sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <!-- Day 4 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/bar_4" android:layout_width="16dp" android:layout_height="100dp" android:background="@drawable/bg_chart_bar_active" />
                        <TextView android:id="@+id/tv_day_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <!-- Day 5 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/bar_5" android:layout_width="16dp" android:layout_height="60dp" android:background="@drawable/bg_chart_bar_inactive" />
                        <TextView android:id="@+id/tv_day_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="F" android:textColor="@color/text_secondary_dark" android:textSize="12sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <!-- Day 6 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/bar_6" android:layout_width="16dp" android:layout_height="24dp" android:background="@drawable/bg_chart_bar_inactive" />
                        <TextView android:id="@+id/tv_day_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="@color/text_secondary_dark" android:textSize="12sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <!-- Day 7 -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
                        <View android:id="@+id/bar_7" android:layout_width="16dp" android:layout_height="20dp" android:background="@drawable/bg_chart_bar_inactive" />
                        <TextView android:id="@+id/tv_day_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="@color/text_secondary_dark" android:textSize="12sp" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Peak Focus Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="24dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PEAK FOCUS"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp"/>

                <!-- Item 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_surface_dark_rounded"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ai_suggestion">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_dialog_info"
                            android:contentDescription="@null"
                            app:tint="@color/primary"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Morning Deep Work"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08:00 - 11:30"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Floating Bottom Nav -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
