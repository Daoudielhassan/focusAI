<?xml version="1.0" encoding="utf-8"?>
<!--
    IMMERSIVE SESSION SCREEN — redesign cinématique
    ┌────────────────────────────────────┐
    │   [← retour]            [00:00]   │  ← top bar flottante
    │                                    │
    │         ░░░░░░░░░░░░░             │
    │       ░░  ╭──────╮  ░░           │  ← glow + anneau progress + orbe
    │      ░░   │  ◷   │   ░░          │    (timer au centre)
    │      ░░   │25:00 │   ░░          │
    │       ░░  ╰──────╯  ░░           │
    │         ░░░░░░░░░░░░░             │
    │                                    │
    │      Restez concentré...           │  ← citation
    │   ●●●●●○ Nightwave Plaza ▶        │  ← equalizer + radio
    │                                    │
    │  ┌────────────────────────────┐   │
    │  │ ⏸  ──────────────────  ✕ │   │  ← dock glassmorphism
    │  └────────────────────────────┘   │
    └────────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ui.session.SessionImmersiveActivity">

    <!-- ═══════════════════════════════════════════════
         BACKGROUND LAYERS
    ════════════════════════════════════════════════ -->

    <!-- Full-screen subtle radial gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_radial_immersive"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Large ambient glow centered behind orb -->
    <View
        android:id="@+id/view_bg_glow"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:alpha="0.25"
        android:background="@drawable/bg_orb_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══════════════════════════════════════════════
         TOP FLOATING BAR
    ════════════════════════════════════════════════ -->

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Session label -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION EN COURS"
                android:textColor="@color/text_secondary_dark"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Mode Immersif"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Timer pill (prominent) -->
        <LinearLayout
            android:id="@+id/pill_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_immersive_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tv_timer_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25:00"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         CENTRAL ORB — plein écran, heroïque
    ════════════════════════════════════════════════ -->

    <FrameLayout
        android:id="@+id/orb_container"
        android:layout_width="320dp"
        android:layout_height="320dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/tv_motivational">

        <!-- Pulsing outer ring (animated in KT) -->
        <View
            android:id="@+id/view_orb_ring_outer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_orb_pulse"
            android:layout_gravity="center" />

        <!-- Circular Progress ring -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_timer"
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_gravity="center"
            app:indicatorSize="288dp"
            app:trackThickness="6dp"
            app:trackColor="#1A13ec5b"
            app:indicatorColor="@color/primary"
            app:indicatorDirectionCircular="clockwise"
            android:max="10000"
            android:progress="10000"
            app:trackCornerRadius="3dp" />

        <!-- Main Orb card -->
        <androidx.cardview.widget.CardView
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            app:cardCornerRadius="120dp"
            app:cardElevation="40dp"
            app:cardBackgroundColor="@color/surface_dark">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_image_placeholder"
                android:contentDescription="@null" />

            <!-- Gradient overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_image_overlay" />

            <!-- Central focus icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:contentDescription="@null"
                    app:tint="@color/primary"
                    android:alpha="0.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOCUS"
                    android:textColor="@color/primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.3"
                    android:layout_marginTop="4dp"
                    android:alpha="0.5" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- ═══════════════════════════════════════════════
         MOTIVATIONAL TEXT
    ════════════════════════════════════════════════ -->

    <TextView
        android:id="@+id/tv_motivational"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restez dans la zone..."
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/row_radio"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ═══════════════════════════════════════════════
         RADIO / EQUALIZER ROW
    ════════════════════════════════════════════════ -->

    <LinearLayout
        android:id="@+id/row_radio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_dock"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Equalizer bars -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginEnd="10dp">

            <View android:id="@+id/eq_bar_1"
                android:layout_width="3dp" android:layout_height="8dp"
                android:background="@color/primary" android:layout_marginEnd="3dp" />
            <View android:id="@+id/eq_bar_2"
                android:layout_width="3dp" android:layout_height="16dp"
                android:background="@color/primary" android:layout_marginEnd="3dp" />
            <View android:id="@+id/eq_bar_3"
                android:layout_width="3dp" android:layout_height="10dp"
                android:background="@color/primary" android:layout_marginEnd="3dp" />
            <View android:id="@+id/eq_bar_4"
                android:layout_width="3dp" android:layout_height="20dp"
                android:background="@color/primary" android:layout_marginEnd="3dp" />
            <View android:id="@+id/eq_bar_5"
                android:layout_width="3dp" android:layout_height="12dp"
                android:background="@color/primary" />
        </LinearLayout>

        <!-- Track info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chargement..."
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <TextView
                android:id="@+id/tv_track_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radio · En direct"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Volume icon -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:contentDescription="@null"
            app:tint="@color/text_secondary_dark"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         BOTTOM DOCK — glassmorphism
    ════════════════════════════════════════════════ -->

    <LinearLayout
        android:id="@+id/bottom_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Controls row inside a glass card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_immersive_dock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <!-- Pause / Resume button -->
            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#3313ec5b">

                <ImageButton
                    android:id="@+id/btn_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="@color/primary"
                    android:contentDescription="Pause" />
            </androidx.cardview.widget.CardView>

            <!-- Progress bar in the middle -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_dock"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                app:trackThickness="4dp"
                app:trackColor="#1A13ec5b"
                app:indicatorColor="@color/primary"
                app:trackCornerRadius="2dp"
                android:max="10000"
                android:progress="10000" />

            <!-- End session button -->
            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FF4444">

                <ImageButton
                    android:id="@+id/btn_emergency"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_delete"
                    app:tint="#FF7777"
                    android:contentDescription="Terminer" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Labels sous les boutons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Pause"
                android:textColor="@color/text_secondary_dark"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Terminer"
                android:textColor="#FF7777"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
