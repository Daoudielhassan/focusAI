<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Glass Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#66192218" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
    <!-- Left glowing border -->
    <item android:right="1000dp" android:bottom="0dp" android:top="0dp">
        <!-- We use padding/margin tricks to simulate a left border but simpler is just a View inside the layout. -->
        <!-- However, a 9-patch or simple layer-list works. Let's use a rectangle shifted left. -->
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="@color/primary" />
        </shape>
    </item>
</layer-list>
